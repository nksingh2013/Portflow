# Copy this file to .env and replace all blank values with generated secrets.
# `scripts/bootstrap-env.ps1` creates a local .env with cryptographically random values.
PORTFLOW_APP_ENV=development
PORTFLOW_DEMO_MODE=true
PORTFLOW_JWT_SECRET=
POSTGRES_ADMIN_PASSWORD=
PORTFLOW_DB_PASSWORD=
PORTFLOW_DATABASE_URL=postgresql+psycopg://portflow_app:replace-me@db:5432/portflow
PORTFLOW_REDIS_URL=redis://redis:6379/0
PORTFLOW_CORS_ORIGINS=http://localhost:5173,http://localhost:8080
PORTFLOW_ACCESS_TOKEN_MINUTES=30
PORTFLOW_DEMO_ADMIN_PASSWORD=
PORTFLOW_DEMO_CUSTOMER_PASSWORD=
PORTFLOW_DEMO_ADMIN_EMAIL=demo-admin@example.com
PORTFLOW_DEMO_CUSTOMER_EMAIL=demo-customer@example.com
